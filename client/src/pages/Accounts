import { useState } from 'react';
import { trpc } from '@/lib/trpc';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Spinner } from '@/components/ui/spinner';
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Plus, Trash2, Power, Settings } from 'lucide-react';
import { useForm } from 'react-hook-form';
import { z } from 'zod';
import { zodResolver } from '@hookform/resolvers/zod';

const createAccountSchema = z.object({
  name: z.string().min(1, 'الاسم مطلوب'),
  username: z.string().optional(),
  platform: z.enum(['telegram', 'whatsapp']),
  accountType: z.string().optional(),
});

type CreateAccountInput = z.infer<typeof createAccountSchema>;

const statusColors: Record<string, string> = {
  active: 'bg-green-100 text-green-800',
  inactive: 'bg-gray-100 text-gray-800',
  error: 'bg-red-100 text-red-800',
  paused: 'bg-yellow-100 text-yellow-800',
};

const statusLabels: Record<string, string> = {
  active: 'نشط',
  inactive: 'معطل',
  error: 'خطأ',
  paused: 'موقوف',
};

export default function Accounts() {
  const { data: accounts, isLoading, refetch } = trpc.accounts.getAccounts.useQuery();
  const createAccount = trpc.accounts.createAccount.useMutation();
  const deleteAccount = trpc.accounts.deleteAccount.useMutation();
  const toggleAccount = trpc.accounts.toggleAccount.useMutation();
  
  const [isOpen, setIsOpen] = useState(false);
  const form = useForm<CreateAccountInput>({
    resolver: zodResolver(createAccountSchema),
  });

  const onSubmit = async (data: CreateAccountInput) => {
    try {
      await createAccount.mutateAsync(data);
      setIsOpen(false);
      form.reset();
      refetch();
    } catch (error) {
      console.error('Error creating account:', error);
    }
  };

  const handleDelete = async (id: number) => {
    if (confirm('هل أنت متأكد من حذف هذا الحساب؟')) {
      try {
        await deleteAccount.mutateAsync({ id });
        refetch();
      } catch (error) {
        console.error('Error deleting account:', error);
      }
    }
  };

  const handleToggle = async (id: number) => {
    try {
      await toggleAccount.mutateAsync({ id });
      refetch();
    } catch (error) {
      console.error('Error toggling account:', error);
    }
  };

  if (isLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <Spinner />
      </div>
    );
  }

  return (
    <div className="space-y-6 p-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold text-gray-900">إدارة الحسابات</h1>
          <p className="text-gray-600 mt-2">إدارة حسابات Telegram و WhatsApp</p>
        </div>
        <Dialog open={isOpen} onOpenChange={setIsOpen}>
          <DialogTrigger asChild>
            <Button className="gap-2">
              <Plus className="h-4 w-4" />
              إضافة حساب جديد
            </Button>
          </DialogTrigger>
          <DialogContent>
            <DialogHeader>
              <DialogTitle>إضافة حساب جديد</DialogTitle>
              <DialogDescription>
                أضف حساب Telegram أو WhatsApp جديد للبحث
              </DialogDescription>
            </DialogHeader>
            <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
              <div>
                <Label htmlFor="name">اسم الحساب</Label>
                <Input
                  id="name"
                  placeholder="مثال: حسابي الشخصي"
                  {...form.register('name')}
                />
              </div>

              <div>
                <Label htmlFor="platform">المنصة</Label>
                <Select
                  value={form.watch('platform') || ''}
                  onValueChange={(value) =>
                    form.setValue('platform', value as 'telegram' | 'whatsapp')
                  }
                >
                  <SelectTrigger>
                    <SelectValue placeholder="اختر المنصة" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="telegram">Telegram</SelectItem>
                    <SelectItem value="whatsapp">WhatsApp</SelectItem>
                  </SelectContent>
                </Select>
              </div>

              <div>
                <Label htmlFor="username">اسم المستخدم (اختياري)</Label>
                <Input
                  id="username"
                  placeholder="@username"
                  {...form.register('username')}
                />
              </div>

              <Button type="submit" className="w-full" disabled={createAccount.isPending}>
                {createAccount.isPending ? 'جاري الإضافة...' : 'إضافة الحساب'}
              </Button>
            </form>
          </DialogContent>
        </Dialog>
      </div>

      {/* Accounts Grid */}
      {accounts && accounts.length > 0 ? (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {accounts.map((account) => (
            <Card key={account.id}>
              <CardHeader>
                <div className="flex items-start justify-between">
                  <div>
                    <CardTitle className="text-lg">{account.name}</CardTitle>
                    <CardDescription>{account.username || 'بدون اسم مستخدم'}</CardDescription>
                  </div>
                  <Badge className={statusColors[account.status]}>
                    {statusLabels[account.status]}
                  </Badge>
                </div>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="space-y-2 text-sm">
                  <div className="flex justify-between">
                    <span className="text-gray-600">المنصة:</span>
                    <span className="font-medium">
                      {account.platform === 'telegram' ? 'Telegram' : 'WhatsApp'}
                    </span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-gray-600">عمليات بحث:</span>
                    <span className="font-medium">{account.searchCount}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-gray-600">روابط مستخرجة:</span>
                    <span className="font-medium">{account.linksExtracted}</span>
                  </div>
                  {account.lastUsed && (
                    <div className="flex justify-between">
                      <span className="text-gray-600">آخر استخدام:</span>
                      <span className="font-medium">
                        {new Date(account.lastUsed).toLocaleDateString('ar-SA')}
                      </span>
                    </div>
                  )}
                </div>

                {account.lastError && (
                  <div className="p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                    {account.lastError}
                  </div>
                )}

                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    className="flex-1 gap-2"
                    onClick={() => handleToggle(account.id)}
                    disabled={toggleAccount.isPending}
                  >
                    <Power className="h-4 w-4" />
                    {account.isEnabled ? 'تعطيل' : 'تفعيل'}
                  </Button>
                  <Button
                    variant="destructive"
                    size="sm"
                    className="flex-1 gap-2"
                    onClick={() => handleDelete(account.id)}
                    disabled={deleteAccount.isPending}
                  >
                    <Trash2 className="h-4 w-4" />
                    حذف
                  </Button>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      ) : (
        <Card>
          <CardContent className="flex flex-col items-center justify-center py-12">
            <Settings className="h-12 w-12 text-gray-300 mb-4" />
            <h3 className="text-lg font-medium text-gray-900">لا توجد حسابات</h3>
            <p className="text-gray-600 mt-2">ابدأ بإضافة حساب جديد للبدء</p>
          </CardContent>
        </Card>
      )}
    </div>
  );
}
