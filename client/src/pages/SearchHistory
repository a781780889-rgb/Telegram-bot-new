import { useState } from 'react';
import { trpc } from '@/lib/trpc';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Spinner } from '@/components/ui/spinner';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { Clock, CheckCircle, AlertCircle, Pause, XCircle } from 'lucide-react';

const statusColors: Record<string, string> = {
  completed: 'bg-green-100 text-green-800',
  running: 'bg-blue-100 text-blue-800',
  failed: 'bg-red-100 text-red-800',
  paused: 'bg-yellow-100 text-yellow-800',
  cancelled: 'bg-gray-100 text-gray-800',
  pending: 'bg-gray-100 text-gray-800',
};

const statusIcons: Record<string, any> = {
  completed: <CheckCircle className="h-4 w-4" />,
  running: <Clock className="h-4 w-4 animate-spin" />,
  failed: <AlertCircle className="h-4 w-4" />,
  paused: <Pause className="h-4 w-4" />,
  cancelled: <XCircle className="h-4 w-4" />,
  pending: <Clock className="h-4 w-4" />,
};

const statusLabels: Record<string, string> = {
  completed: 'مكتملة',
  running: 'جاري التنفيذ',
  failed: 'فاشلة',
  paused: 'موقوفة',
  cancelled: 'ملغاة',
  pending: 'قيد الانتظار',
};

export default function SearchHistory() {
  const [offset, setOffset] = useState(0);
  const limit = 20;

  const { data: searchesData, isLoading } = trpc.searches.getSearches.useQuery({
    limit,
    offset,
  });

  const searches = searchesData?.searches || [];
  const total = searchesData?.total || 0;

  const formatDuration = (seconds?: number) => {
    if (!seconds) return '-';
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const secs = seconds % 60;
    
    if (hours > 0) {
      return `${hours}h ${minutes}m`;
    } else if (minutes > 0) {
      return `${minutes}m ${secs}s`;
    } else {
      return `${secs}s`;
    }
  };

  if (isLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <Spinner />
      </div>
    );
  }

  return (
    <div className="space-y-6 p-6">
      {/* Header */}
      <div>
        <h1 className="text-3xl font-bold text-gray-900">📋 سجل البحث</h1>
        <p className="text-gray-600 mt-2">عرض جميع عمليات البحث السابقة والحالية</p>
      </div>

      {/* Statistics */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        <Card>
          <CardHeader className="pb-3">
            <CardTitle className="text-sm">إجمالي البحوث</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{total}</div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader className="pb-3">
            <CardTitle className="text-sm">مكتملة</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-green-600">
              {searches.filter((s) => s.status === 'completed').length}
            </div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader className="pb-3">
            <CardTitle className="text-sm">جاري التنفيذ</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-blue-600">
              {searches.filter((s) => s.status === 'running').length}
            </div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader className="pb-3">
            <CardTitle className="text-sm">فاشلة</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-red-600">
              {searches.filter((s) => s.status === 'failed').length}
            </div>
          </CardContent>
        </Card>
      </div>

      {/* Searches Table */}
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">عمليات البحث</CardTitle>
          <CardDescription>
            عرض {offset + 1} إلى {Math.min(offset + limit, total)} من {total}
          </CardDescription>
        </CardHeader>
        <CardContent>
          {searches.length > 0 ? (
            <div className="overflow-x-auto">
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>الاسم</TableHead>
                    <TableHead>الحالة</TableHead>
                    <TableHead>المنصات</TableHead>
                    <TableHead>النتائج</TableHead>
                    <TableHead>الجديدة</TableHead>
                    <TableHead>المكررة</TableHead>
                    <TableHead>المدة</TableHead>
                    <TableHead>التاريخ</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {searches.map((search) => (
                    <TableRow key={search.id} className="hover:bg-gray-50 cursor-pointer">
                      <TableCell className="font-medium">{search.searchName}</TableCell>
                      <TableCell>
                        <Badge className={statusColors[search.status]}>
                          <span className="flex items-center gap-1">
                            {statusIcons[search.status]}
                            {statusLabels[search.status]}
                          </span>
                        </Badge>
                      </TableCell>
                      <TableCell>
                        {search.platforms === 'telegram,whatsapp'
                          ? 'كلاهما'
                          : search.platforms === 'telegram'
                            ? 'Telegram'
                            : 'WhatsApp'}
                      </TableCell>
                      <TableCell>{search.totalFound}</TableCell>
                      <TableCell className="text-green-600 font-medium">{search.totalNew}</TableCell>
                      <TableCell className="text-orange-600 font-medium">{search.totalDuplicate}</TableCell>
                      <TableCell>{formatDuration(search.duration || undefined)}</TableCell>
                      <TableCell className="text-sm text-gray-500">
                        {new Date(search.createdAt).toLocaleDateString('ar-SA')}
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          ) : (
            <div className="flex flex-col items-center justify-center py-12">
              <Clock className="h-12 w-12 text-gray-300 mb-4" />
              <h3 className="text-lg font-medium text-gray-900">لا توجد عمليات بحث</h3>
              <p className="text-gray-600 mt-2">ابدأ بإنشاء عملية بحث جديدة</p>
            </div>
          )}

          {/* Pagination */}
          {searches.length > 0 && (
            <div className="flex items-center justify-between mt-4 pt-4 border-t">
              <span className="text-sm text-gray-600">
                عرض {offset + 1} إلى {Math.min(offset + limit, total)} من {total}
              </span>
              <div className="flex gap-2">
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => setOffset(Math.max(0, offset - limit))}
                  disabled={offset === 0}
                >
                  السابق
                </Button>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => setOffset(offset + limit)}
                  disabled={offset + limit >= total}
                >
                  التالي
                </Button>
              </div>
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  );
}
